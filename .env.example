# ==================== GitLab（代码 / 文档同步）====================
# 用于通过 OAuth password grant 拉取工具仓库代码
GITLAB_BASE_URL=http://100.64.0.45:8999
GITLAB_USERNAME=your_gitlab_email_here
GITLAB_PASSWORD=your_gitlab_password_here
# 或直接使用 Personal Access Token（推荐，避免明文密码）
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_PROJECT_ID=207

# ==================== XXAI 企管用户导出（export_users.py）====================
# 商户端 API 基址
XXAI_API_BASE=https://merchant-api.xxai.com
# 商户端 Bearer Token（登录 business.xxai.com 后从浏览器请求头 Authorization 复制；勿提交）
XXAI_TOKEN=your_merchant_bearer_token_here
# 导出来源：pool=用户池(约10000,含email) / register=企管注册用户(约21)
XXAI_SOURCE=pool
# 导出数量
XXAI_COUNT=2000
# /user/assume 并发数（获取密码/pincode）
XXAI_CONCURRENCY=8

# ==================== 发帖 API（后端环境）====================
# pre 环境（生产预发布，adminweb.xxai.com 管理后台对应）
LOGIN_URL=https://api.xxai.com/login
UPLOAD_CREDENTIALS_URL=https://api.xxai.com/file/upload/credentials
MOMENTS_API_URL=https://feed-api.xxai.com/api/v1/moments/

# --- 以下为历史环境，仅供参考，不再使用 ---
# dev 环境（已废弃）
# LOGIN_URL=https://devapi-x.tp-ex.com/login
# UPLOAD_CREDENTIALS_URL=https://devapi-x.tp-ex.com/file/upload/credentials
# MOMENTS_API_URL=http://100.64.0.47:8889/api/v1/moments/
#
# test 环境（已废弃）
# LOGIN_URL=https://testapi-x.tp-ex.com/login
# UPLOAD_CREDENTIALS_URL=https://testapi-x.tp-ex.com/file/upload/credentials
# MOMENTS_API_URL=http://100.64.0.53:8889/api/v1/moments/

# ==================== 账号 / 素材 CSV ====================
# 真实账号 CSV 不要入库；只在本地放置
POST_DEFAULT_ACCOUNTS_CSV=accounts_10.csv
POST_DEFAULT_CSV=moments.csv
POST_DEFAULT_CONCURRENCY=1
POST_DEFAULT_DELAY=2.0
POST_MAX_IMAGES=9
POST_DEVICE_ID=auto_poster
POST_DEVICE_NAME=auto_poster_client
POST_REQUEST_TIMEOUT=15

# 顺序登录间距（避开 429）；publish_from_tokens.py 使用
LOGIN_SPACING=2.5

# ==================== 图片处理策略（参见 docs/23-image-policy.md）====================
# 水印裁切：对命中域名的图片裁掉底部一条去除水印
POST_CROP_BOTTOM_HOSTS=xhscdn.com,xiaohongshu.com,bbkz.net,erv-nsa.gov.tw
POST_CROP_BOTTOM_PCT=0.08

# 水印域名跳过：来自这些域名的图片直接跳过不上传（帖子降级为纯文本）
POST_WATERMARK_SKIP_HOSTS=500px.com,dpreview.com,petapixel.com,gettyimages.com,shutterstock.com,istockphoto.com,alamy.com,dreamstime.com,depositphotos.com,123rf.com,stockphoto.com

# 图片最小尺寸门槛：低于此尺寸的图片视为缩略图，跳过
POST_MIN_IMAGE_WIDTH=400
POST_MIN_IMAGE_HEIGHT=300

# 多图宽高比一致性容差（25% = 同帖图片 AR 偏差不超过中位数的 25%）
POST_IMAGE_AR_TOLERANCE=0.25

# 网格友好数量调整（true=启用，自动将 5→4, 7→6, 8→6 等非网格数量向下取整）
POST_GRID_FRIENDLY=true

# 方向感知图片数量上限（竖图占更多纵向空间，需限制数量）
POST_MAX_PORTRAIT_IMAGES=4
POST_MAX_LANDSCAPE_IMAGES=6
POST_MAX_SQUARE_IMAGES=9

# 下载时对 TLS 链不完整的域名放行（gov 站，如台湾观光署 erv-nsa.gov.tw）；逗号分隔
POST_NO_VERIFY_HOSTS=erv-nsa.gov.tw

# ==================== 素材源 ====================
# OpenNana
OPENNANA_API_BASE=https://api.opennana.com
OPENNANA_REFERER=https://opennana.com/
OPENNANA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# open-prompts.com
OPENPROMPTS_API_BASE=https://www.open-prompts.com/api
OPENPROMPTS_REFERER=https://www.open-prompts.com/

# lovimg.com
LOVIMG_BASE=https://lovimg.com
LOVIMG_REFERER=https://lovimg.com/zh

# tophub.today（热榜文本源，公开无需登录；以下全部可留默认）
# 参见 docs/14-tophub-source.md。切勿在此填写任何 tophub 账号密码。
TOPHUB_HOT_URL=https://tophub.today/hot
TOPHUB_REFERER=https://tophub.today/
TOPHUB_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# yituyu.com / tuziyouwang.com（高清图片源，公开无需登录；均可留默认）
# 参见 docs/15-image-hd-sources.md。注意：发布前需按各站 Referer 预下载图片（§15.5）。
YITUYU_BASE=https://www.yituyu.com
YITUYU_REFERER=https://www.yituyu.com/
YITUYU_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
TUZI_BASE=http://tuziyouwang.com
TUZI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# cizucu.com（刺猬社区，摄影社区；公开无需登录；均可留默认）
# 参见 docs/23-cizucu.md。Next.js+Firebase 单页应用，需 Playwright 渲染采集；
# 原图直链 https://cdn.cizucu.com/images/photos/<photoId>.jpg 公开、无需 Referer。
# 切勿在此填写任何账号密码。
CIZUCU_BASE=https://www.cizucu.com
CIZUCU_CDN=https://cdn.cizucu.com
CIZUCU_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# Web3 资讯多源（9 个媒体，公开无需登录；均可留默认）
# 参见 docs/24-web3-sources.md。fetch_web3.py 内置各站取数逻辑（含 foresight base64+zlib
# 解压、wublock 阿里云 WAF cookie 求解、menews 需 Origin/Referer 头等）。
# 切勿在此填写任何站点账号密码。以下 UA 供各站请求复用，一般无需修改。
WEB3_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# ==================== 多源 & 广告过滤 ====================
# 参见 docs/12-multi-source.md 与 docs/11-anti-ad-filtering.md
MULTI_SOURCE_DEFAULT=opennana,openprompts,lovimg
# 如需混入 tophub 纯文本热榜话题：opennana,openprompts,lovimg,tophub
# 如需混入 yituyu / tuzi 高清写真图：opennana,openprompts,lovimg,yituyu,tuzi
MULTI_SOURCE_EXCLUDE_ADS_DEFAULT=true
MULTI_SOURCE_THEME_DEFAULT=beauty

# ==================== 多语言文案 ====================
# 参见 docs/13-multilang-captions.md
# 支持：en / zh / zh_hant / ja；空 = 只用 zh
CAPTION_LANGS_DEFAULT=en,zh_hant,ja

# ==================== 重试配置 ====================
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY=1.0
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY=10.0

# ==================== 输出目录 ====================
RESULT_DIR=result
LOG_DIR=logs
LOG_LEVEL=INFO

# ==================== Vision / Text LLM（可选，用于文案改写）====================
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# LLM_VL_API_KEY=
# LLM_VL_API_BASE=
# LLM_VL_MODEL=
# LLM_TEXT_API_KEY=
# LLM_TEXT_API_BASE=
# LLM_TEXT_MODEL=

# ==================== 小红书爬虫（可选，legacy）====================
CRAWL_DEFAULT_TARGET=200
CRAWL_DEFAULT_MAX_REQUESTS=30
CRAWL_DEFAULT_DELAY=1.5
# ==================== 群组/房间发帖（post_room_moments.py）====================
# 见 docs/21-room-group-post.md。房间发帖走 feed 网关域名；Matrix 消息走 d.xxai.com。
# 房间发帖端点（默认走 feed 网关）
ROOM_MOMENTS_API_URL=https://feed-api.xxai.com/api/v1/moments
# Matrix client-server API 到 /rooms 的前缀（第2步 m.room.message）
MATRIX_API_BASE=https://d.xxai.com/_matrix/client/v3/rooms
# 读房间 feed（核对/去重用）
ROOM_FEED_URL=https://feed-api.xxai.com/api/v1/feed/room_moments
# 发帖账号 / 目标房间（请勿提交真实值；本文件仅示例）
ROOM_POST_EMAIL=your_account@example.com
ROOM_POST_PASSWORD=your_password_here
# 目标房间 Matrix ID（形如 !xxxxxxxx:xxai.com，原样字符串）
ROOM_POST_ROOM_ID=!your_room_id:xxai.com
# 外部图片下载后暂存目录（转存 S3 前）
ROOM_POST_IMG_DIR=images